*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

c/build/_deps/picotool-src/
# Ignore build directories and artifacts
build/
_deps/
generated/
pico-sdk/
version.c
version.h

# Ignore temporary or build-related files
*.o
*.so
*.a
*.log
# *.cmake
*.stamp
*.tmp
*.xcf

# Ignore specific generated files
pico_flash_region.ld
ds3231_clock_setup/

# Private credentials
**/wifi_credentials.h
**/seatsurfing_api.h

# KiCad project metadata
*.kicad_prl
*.kicad_pcb.lck
*.kicad_sch.lck
_autosave-*.kicad_pcb
_autosave-*.kicad_sch
*.bak
*.FCBak
**/fp-info-cache
# KiCad 9 local file history (auto-snapshots, not design data)
**/.history/
*-backups/

# External UF2 tools (auto-downloaded by create_uf2.sh)
firmware/c/uf2conv.py
firmware/c/uf2families.json

# Docs build output (do not commit generated site)
docs/_site/
docs/vendor/

# Firmware build output
firmware/c/build/

# TLS cert sources (public CA material; not required in repo)
firmware/c/certs/*.pem
firmware/c/certs/*.p7c
firmware/c/certs/trust_store.pem
firmware/c/certs/trust_store_pem.h

# Public export output
out/

# inki-monitor runtime files
inki-monitor/.venv/
inki-monitor/config.yaml
inki-monitor/data/
inki-monitor/__pycache__/
inki-monitor/*.pyc

# FreeCAD autosave backups
*.FCBak

# Local tool state

# CMake build output accidentally committed in the past
**/CMakeFiles/

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Python caches (anywhere, not just inki-monitor)
__pycache__/
*.pyc
.venv/

# Tracer bullets: local server addresses, passwords and tokens
firmware/c/*/tracer_config.h
